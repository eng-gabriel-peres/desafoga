// Banco do Desafoga. Valores em centavos (Int) e taxas como fração ao mês.
// As contas são feitas em src/lib/finance; o banco só guarda.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Um "mundo" de dados. DEMO: cópia dos dados fictícios para quem entra como
/// Ana ou Paula (cada visita ganha a sua). REAL: as contas criadas de verdade.
model Espaco {
  id            String         @id @default(uuid())
  tipo          TipoDeEspaco
  criadoEm      DateTime       @default(now())
  pessoas       Pessoa[]
  profissionais Profissional[]
  sessoes       Sessao[]

  @@map("espacos")
}

enum TipoDeEspaco {
  DEMO
  REAL
}

/// Quem está usando o app neste navegador. O cookie guarda um token
/// aleatório; aqui fica só o hash dele.
model Sessao {
  id             String        @id
  espacoId       String
  espaco         Espaco        @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  pessoaId       String?
  pessoa         Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  criadaEm       DateTime      @default(now())
  expiraEm       DateTime

  @@index([espacoId])
  @@map("sessoes")
}

model Pessoa {
  id                 String                 @id @default(uuid())
  espacoId           String
  espaco             Espaco                 @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  /// Id curto dos dados fictícios ("ana"), para a demo achar a persona.
  slug               String?
  nome               String
  apelido            String
  idade              Int?
  cor                String
  perfil             String                 @default("")
  /// WhatsApp confirmado (só dígitos, com 55).
  telefone           String?                @unique
  criadaEm           DateTime               @default(now())
  compras            Compra[]
  dividas            Divida[]
  plano              Plano?
  faturas            Fatura[]
  memoria            Memoria?
  anotacoes          Anotacao[]
  avisos             Aviso[]
  mensagens          Mensagem[]
  estados            EstadoConversa[]
  conquistas         Conquista[]
  participacoes      ParticipanteDoEvento[]
  comentarios        ComentarioDoConteudo[]
  seguindo           Seguir[]
  postsDeEventos     PostDoEvento[]
  acompanhamentos    Acompanhamento[]
  sessoes            Sessao[]
  orcamentos         Orcamento[]
  metas              Meta[]
  rotina             Rotina?
  checkins           CheckIn[]
  contasFixas        ContaFixa[]
  pagamentos         Pagamento[]
  /// Quanto entra por mês (centavos); null se não informou.
  rendaMensal        Int?
  /// Dia do mês em que recebe.
  diaDaRenda         Int?
  /// Compras do banco: revisar (padrão), automatico ou desligado.
  modoComprasDoBanco String                 @default("revisar")
  conexoes           ConexaoBancaria[]
  movimentos         Movimento[]
  parceladas         CompraParcelada[]
  sugestoes          Sugestao[]
  regrasDoBanco      RegraDoBanco[]
  investimentos      InvestimentoBancario[]

  @@unique([espacoId, slug])
  @@map("pessoas")
}

model Profissional {
  id              String           @id @default(uuid())
  espacoId        String
  espaco          Espaco           @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  slug            String?
  nome            String
  papel           String
  cor             String
  /// Código que a pessoa digita para ser acompanhada por este profissional.
  convite         String           @unique
  /// Apresentação no perfil de Conteúdos.
  bio             String           @default("")
  criadoEm        DateTime         @default(now())
  acompanhamentos Acompanhamento[]
  anotacoes       Anotacao[]
  sessoes         Sessao[]
  conquistas      Conquista[]
  eventos         Evento[]
  conteudos       Conteudo[]
  comentarios     ComentarioDoConteudo[]
  seguidores      Seguir[]
  postsDeEventos  PostDoEvento[]

  @@unique([espacoId, slug])
  @@map("profissionais")
}

/// A pessoa aceitou ser acompanhada pelo profissional.
model Acompanhamento {
  pessoaId       String
  pessoa         Pessoa       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  consentidoEm   DateTime     @default(now())

  @@id([pessoaId, profissionalId])
  @@map("acompanhamentos")
}

model Compra {
  /// A pessoa disse que não lembra como estava (emocao fica null e a compra não é cobrada de novo).
  naoLembra             Boolean          @default(false)
  id                    String       @id @default(uuid())
  pessoaId              String
  pessoa                Pessoa       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  item                  String
  categoria             String
  valor                 Int
  /// 1 muito triste … 5 muito feliz; nulo quando veio do banco e a pessoa ainda não disse.
  emocao                Int?
  necessidade           String?
  quando                DateTime
  via                   String
  avaliacaoProfissional String?
  /// Compra parcelada: quantas vezes e o valor de cada (o valor é o total).
  parcelas              Int?
  valorDaParcela        Int?
  parceladaId           String?
  lancamentos           Lancamento[]
  movimentos            Movimento[]

  @@index([pessoaId, quando])
  @@map("compras")
}

model Divida {
  id            String @id @default(uuid())
  pessoaId      String
  pessoa        Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo          String
  nome          String
  detalhe       String @default("")
  saldo         Int
  /// Fração ao mês: 0.142 = 14,2% a.m.
  taxaMensal    Float
  parcelaMinima Int
  vencimento    Int

  /// manual, banco (Pluggy) ou documento.
  origem             String    @default("manual")
  /// pluggy, contrato, registrato, fatura ou extrato (a mais confiável que já atualizou).
  fonte              String?
  chave              String?
  pluggyLoanId       String?   @unique
  conexaoId          String?
  instituicao        String?
  cet                Float?
  parcelasRestantes  Int?
  temSeguro          Boolean?
  vencido            Int?
  faltaPagarComJuros Int?
  atualizadaEm       DateTime?
  /// Campos que a pessoa precisa conferir (saldo, taxaMensal, parcelaMinima, parcelasRestantes).
  confira            String[]  @default([])
  /// Valores corrigidos pela pessoa: { campo: valor }. Valem sobre o que a fonte diz.
  correcoes          Json?
  /// Campos que a pessoa completou porque a fonte não trazia: a correção sai quando a fonte passar a mandar.
  conferidos         String[]  @default([])

  @@unique([pessoaId, chave])
  @@index([pessoaId])
  @@map("dividas")
}

model Plano {
  pessoaId      String @id
  pessoa        Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  valorMensal   Int    @default(0)
  estrategia    String @default("mais-cara")
  valorSugerido Int?

  @@map("planos")
}

model Fatura {
  id                 String       @id @default(uuid())
  pessoaId           String
  pessoa             Pessoa       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo               String
  origem             String
  /// YYYY-MM
  mes                String
  criadaEm           DateTime     @default(now())
  lancamentos        Lancamento[]
  /// documento ou pluggy.
  fonte              String       @default("documento")
  pluggyBillId       String?      @unique
  contaId            String?
  vencimento         String?
  total              Int?
  pagamentoMinimo    Int?
  taxaRotativoMensal Float?
  foraDosCalculos    Boolean      @default(false)

  @@index([pessoaId, mes])
  @@map("faturas")
}

model Lancamento {
  id            String  @id @default(uuid())
  faturaId      String
  fatura        Fatura  @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  data          String
  descricao     String
  valor         Int
  tipo          String
  categoria     String?
  compraId      String?
  compra        Compra? @relation(fields: [compraId], references: [id], onDelete: SetNull)
  ordem         Int     @default(0)
  parcela       Int?
  totalParcelas Int?

  @@index([faturaId])
  @@map("lancamentos")
}

model Memoria {
  pessoaId        String   @id
  pessoa          Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  caracteristicas String[]
  tom             String   @default("acolhedor")
  objetivo        String   @default("")
  evitar          String   @default("")

  @@map("memorias")
}

model Anotacao {
  id       String       @id @default(uuid())
  pessoaId String
  pessoa   Pessoa       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  autorId  String
  autor    Profissional @relation(fields: [autorId], references: [id], onDelete: Cascade)
  texto    String
  /// Privada: a pessoa não vê, e o texto não vai para a IA.
  privada  Boolean      @default(false)
  quando   DateTime     @default(now())

  @@index([pessoaId])
  @@map("anotacoes")
}

model Aviso {
  id         String   @id @default(uuid())
  pessoaId   String
  pessoa     Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo       String
  texto      String
  quando     DateTime @default(now())
  /// Movimento do banco a que o aviso se refere (some junto quando o banco apaga).
  referencia String?
  lidos      AvisoLido[]

  @@index([pessoaId, quando])
  @@map("avisos")
}

/// Quem já viu o aviso (a pessoa ou cada profissional, separados).
model AvisoLido {
  avisoId String
  aviso   Aviso  @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  quem    String

  @@id([avisoId, quem])
  @@map("avisos_lidos")
}

/// Mensagens da conversa com a Luana, separadas por canal (app e WhatsApp).
model Mensagem {
  id               String   @id @default(uuid())
  pessoaId         String
  pessoa           Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  canal            String
  de               String
  texto            String
  quando           DateTime @default(now())
  respostasRapidas Json?

  @@index([pessoaId, canal, quando])
  @@map("mensagens")
}

/// Pergunta em aberto da Luana (compra esperando emoção, por exemplo), por canal.
model EstadoConversa {
  pessoaId String
  pessoa   Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  canal    String
  estado   Json

  @@id([pessoaId, canal])
  @@map("estados_conversa")
}

/// Dados curtos e temporários: códigos e links do WhatsApp, contato recente.
model Registro {
  chave        String   @id
  dados        Json
  atualizadoEm DateTime @default(now()) @updatedAt

  @@map("registros")
}

/// Quanto a pessoa se permite gastar por mês numa categoria.
model Orcamento {
  pessoaId  String
  pessoa    Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  categoria String
  /// Centavos por mês.
  limite    Int

  @@id([pessoaId, categoria])
  @@map("orcamentos")
}

/// Meta de guardar dinheiro (viagem, reserva, cofrinho).
model Meta {
  id              String            @id @default(uuid())
  pessoaId        String
  pessoa          Pessoa            @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  nome            String
  /// piggy-bank, shield, plane, home, car, graduation-cap, gift, smartphone, heart.
  icone           String            @default("piggy-bank")
  /// azul, amarelo, coral, violeta, petroleo.
  cor             String            @default("azul")
  /// Centavos.
  alvo            Int
  /// Quanto já tinha ao criar (centavos).
  inicial         Int               @default(0)
  /// "prazo" (escolheu uma data) ou "valor" (escolheu quanto guardar).
  modo            String            @default("valor")
  /// dia, semana ou mes.
  frequencia      String            @default("mes")
  /// Quanto guardar por período (centavos).
  valorPorPeriodo Int               @default(0)
  lembrete        Boolean           @default(true)
  prazo           DateTime?         @db.Date
  criadaEm        DateTime          @default(now())
  /// Investimentos da Pluggy ligados à meta (entrega 2).
  investimentos   String[]          @default([])
  movimentos      MovimentoDaMeta[]

  @@index([pessoaId])
  @@map("metas")
}

/// Dinheiro guardado na meta: a transferência é registrada uma vez só e já conta.
model MovimentoDaMeta {
  id        String   @id @default(uuid())
  metaId    String
  meta      Meta     @relation(fields: [metaId], references: [id], onDelete: Cascade)
  /// Centavos.
  valor     Int
  descricao String   @default("")
  quando    DateTime
  via       String

  @@index([metaId, quando])
  @@map("movimentos_das_metas")
}

/// Contador de uso por dia (limites contra abuso). Criado também em tempo de execução por `lib/limite.ts`.
model Uso {
  chave String
  dia   DateTime @db.Date
  total Int

  @@id([chave, dia])
  @@map("uso")
}

/// Horários dos check-ins e escolhas de privacidade da pessoa.
model Rotina {
  pessoaId           String  @id
  pessoa             Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  /// "HH:MM".
  horarioManha       String  @default("08:00")
  horarioTarde       String  @default("12:00")
  horarioNoite       String  @default("20:00")
  manhaLigado        Boolean @default(true)
  tardeLigado        Boolean @default(true)
  noiteLigado        Boolean @default(true)
  /// Quem acompanha recebe aviso quando a pessoa responde 1 ou 2.
  avisarQuandoTriste Boolean @default(true)
  /// Profissionais podem ver as contas fixas e a renda.
  compartilharContas Boolean @default(true)
  /// "Avisos no WhatsApp" do painel (como no protótipo), configurados por quem acompanha.
  lembreteDiario     Boolean @default(false)
  horaDoLembrete     String  @default("21:00")
  avisarCompraAlta   Boolean @default(true)
  /// Centavos.
  valorDaCompraAlta  Int     @default(20000)
  avisarDiaDificil   Boolean @default(true)
  resumoDaSemana     Boolean @default(true)

  @@map("rotinas")
}

/// Como a pessoa está ao acordar, ao meio-dia e à noite (uma resposta por período por dia).
model CheckIn {
  id       String   @id @default(uuid())
  pessoaId String
  pessoa   Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  dia      DateTime @db.Date
  /// manha, tarde ou noite.
  periodo  String
  /// 1 (muito triste) a 5 (muito feliz).
  humor    Int
  quando   DateTime @default(now())

  @@unique([pessoaId, dia, periodo])
  @@map("checkins")
}

/// O que a pessoa paga todo mês.
model ContaFixa {
  id               String   @id @default(uuid())
  pessoaId         String
  pessoa           Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  nome             String
  /// moradia, luz, agua, internet, transporte, saude, educacao, assinatura, outra.
  categoria        String   @default("outra")
  /// Centavos; nas contas que mudam todo mês, a média.
  valor            Int
  /// Dia do mês (1 a 31).
  vencimento       Int
  variavel         Boolean  @default(false)
  debitoAutomatico Boolean  @default(false)
  lembrete         Boolean  @default(true)
  criadaEm         DateTime @default(now())

  @@index([pessoaId])
  @@map("contas_fixas")
}

/// Pagamento do mês de uma conta fixa ou da parcela de uma dívida.
model Pagamento {
  id       String   @id @default(uuid())
  pessoaId String
  pessoa   Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  /// conta ou divida.
  tipo     String
  alvoId   String
  /// "YYYY-MM".
  mes      String
  /// Centavos.
  valor    Int
  quando   DateTime @default(now())

  @@unique([tipo, alvoId, mes])
  @@index([pessoaId, mes])
  @@map("pagamentos")
}

/// Banco conectado pela Pluggy (um "item"). pluggyItemId nulo = Banco Demonstração.
model ConexaoBancaria {
  id                        String                 @id @default(uuid())
  pessoaId                  String
  pessoa                    Pessoa                 @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  pluggyItemId              String?                @unique
  banco                     String
  logo                      String?
  /// ok, atualizando, reconectar ou erro.
  status                    String                 @default("ok")
  erro                      String?
  ultimaSincronizacao       DateTime?
  ultimoPedidoDeAtualizacao DateTime?
  sincronizandoDesde        DateTime?
  /// Última vez que o agendador tentou atualizar (dá certo ou não): quem falha espera a vez de novo.
  ultimaTentativaAutomatica DateTime?
  consentimentoAte          DateTime?
  cpfDoTitular              String?
  conectadaEm               DateTime               @default(now())
  contas                    ContaBancaria[]
  investimentos             InvestimentoBancario[]

  @@index([pessoaId])
  @@map("conexoes_bancarias")
}

model ContaBancaria {
  id                   String          @id @default(uuid())
  conexaoId            String
  conexao              ConexaoBancaria @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  pluggyAccountId      String          @unique
  /// corrente, poupanca ou cartao.
  tipo                 String
  nome                 String
  saldo                Int
  limite               Int?
  limiteDisponivel     Int?
  fechamento           String?
  vencimento           String?
  chequeEspecialUsado  Int?
  chequeEspecialLimite Int?
  movimentos           Movimento[]

  @@map("contas_bancarias")
}

/// Transação do banco já normalizada (valor em centavos, positivo).
model Movimento {
  id                   String           @id @default(uuid())
  pessoaId             String
  pessoa               Pessoa           @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  contaId              String
  conta                ContaBancaria    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  pluggyId             String           @unique
  /// YYYY-MM-DD em Brasília.
  data                 String
  descricao            String
  descricaoOriginal    String
  valor                Int
  direcao              String
  natureza             String
  categoria            String?
  categoriaPluggy      String?
  /// revisar, registrada, ignorada, historico ou automatica.
  situacao             String
  compraId             String?
  compra               Compra?          @relation(fields: [compraId], references: [id], onDelete: SetNull)
  parceladaId          String?
  parcelada            CompraParcelada? @relation(fields: [parceladaId], references: [id], onDelete: SetNull)
  parcela              Int?
  totalParcelas        Int?
  valorTotalDaCompra   Int?
  compradaEm           String?
  faturaPrevista       String?
  cnpj                 String?
  mcc                  Int?
  documentoContraparte String?
  jurosBoleto          Int?
  pendente             Boolean          @default(false)
  criadoEm             DateTime         @default(now())

  @@index([pessoaId, data])
  @@map("movimentos")
}

model CompraParcelada {
  id                 String      @id @default(uuid())
  pessoaId           String
  pessoa             Pessoa      @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  chave              String
  origem             String
  /// pluggy ou documento.
  fonte              String
  nome               String
  lojaOriginal       String
  categoria          String
  valorTotal         Int
  valorParcela       Int
  totalParcelas      Int
  mesDaPrimeira      String
  compradaEm         String
  compradaEmEstimada Boolean     @default(false)
  compraId           String?
  parcelasVistas     Int[]       @default([])
  /// Já gerou aviso "para revisar" (pede emoção uma vez só).
  avisada            Boolean     @default(false)
  movimentos         Movimento[]

  @@unique([pessoaId, chave])
  @@map("compras_parceladas")
}

/// Sugestão vinda do banco ou de documento (dívida, renda): a pessoa aceita ou dispensa.
model Sugestao {
  id           String   @id @default(uuid())
  pessoaId     String
  pessoa       Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  chave        String
  /// divida ou renda.
  tipo         String
  dados        Json
  /// aberta, aceita ou dispensada.
  situacao     String   @default("aberta")
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@unique([pessoaId, chave])
  @@map("sugestoes")
}

/// O que a pessoa ensinou: "PIX JOAO é transferência minha", "CARREFOUR é Casa".
model RegraDoBanco {
  id       String   @id @default(uuid())
  pessoaId String
  pessoa   Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  padrao   String
  efeito   Json
  criadaEm DateTime @default(now())

  @@unique([pessoaId, padrao])
  @@map("regras_do_banco")
}

/// Investimento lido do banco (poupança, CDB, fundo…): pode ser ligado a uma meta.
model InvestimentoBancario {
  id           String          @id @default(uuid())
  pessoaId     String
  pessoa       Pessoa          @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  conexaoId    String
  conexao      ConexaoBancaria @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  pluggyId     String          @unique
  nome         String
  tipo         String
  /// Centavos.
  saldo        Int
  atualizadoEm DateTime        @default(now())

  @@index([pessoaId])
  @@map("investimentos_bancarios")
}

/// Meta com prêmio que o profissional cria para a pessoa (como no protótipo).
model Conquista {
  id          String        @id @default(uuid())
  pessoaId    String
  pessoa      Pessoa        @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  autorId     String?
  autor       Profissional? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  /// broto, caderno, brilho, estrela, alvo, raio, medalha, festa.
  icone       String
  titulo      String
  /// sem-impulso, registrar, nota-boa.
  tipo        String
  alvo        Int
  premio      String        @default("")
  criadaEm    DateTime      @default(now())
  /// Quando foi alcançada (a Luana parabeniza uma vez só).
  concluidaEm DateTime?

  @@index([pessoaId])
  @@map("conquistas")
}

/// Desafio em grupo ou encontro presencial criado por um profissional.
model Evento {
  id             String                 @id @default(uuid())
  profissionalId String
  profissional   Profissional           @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  /// desafio, presencial.
  tipo           String
  nome           String
  descricao      String                 @default("")
  /// Desafio: sem-desnecessaria, sem-categoria, limite-dia, nota-boa.
  regra          String?
  categoria      String?
  /// Centavos, na regra limite-dia.
  limite         Int?
  /// "YYYY-MM-DD" (desafio).
  inicio         String?
  fim            String?
  /// "YYYY-MM-DD" e "HH:MM" (presencial).
  data           String?
  hora           String?
  local          String?
  premio         String                 @default("")
  mostrarRanking Boolean                @default(true)
  /// Código do link de convite (aleatório); null com o link desligado.
  convite        String?                @unique
  criadoEm       DateTime               @default(now())
  participantes  ParticipanteDoEvento[]
  posts          PostDoEvento[]

  @@index([profissionalId])
  @@map("eventos")
}

model ParticipanteDoEvento {
  eventoId String
  evento   Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  pessoaId String
  pessoa   Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD": os dias antes disso não contam no desafio.
  entrouEm String
  /// Presencial: vou, talvez, nao (null sem resposta).
  resposta String?
  /// O profissional convida; só depois de aceitar a pessoa aparece para o grupo.
  aceito   Boolean @default(false)

  @@id([eventoId, pessoaId])
  @@index([pessoaId])
  @@map("participantes_dos_eventos")
}

/// Post do mural do evento: de uma pessoa, do profissional ou do sistema (sem autor).
model PostDoEvento {
  id             String        @id @default(uuid())
  eventoId       String
  evento         Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  pessoaId       String?
  pessoa         Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  /// recado, dica, conquista, desabafo, aviso (só profissional), sistema.
  tipo           String
  texto          String
  fixado         Boolean       @default(false)
  criadoEm       DateTime      @default(now())
  apoios         ApoioDoPost[]

  @@index([eventoId, criadoEm])
  @@map("posts_dos_eventos")
}

/// "Apoiar" um post: quem é o id da pessoa ou do profissional.
model ApoioDoPost {
  postId String
  post   PostDoEvento @relation(fields: [postId], references: [id], onDelete: Cascade)
  quem   String

  @@id([postId, quem])
  @@map("apoios_dos_posts")
}

/// Publicação de um profissional no feed de Conteúdos (visto por todo o espaço).
model Conteudo {
  id               String                 @id @default(uuid())
  profissionalId   String
  profissional     Profissional           @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  /// dica, artigo, carrossel, enquete.
  tipo             String
  tema             String
  /// azul, ambar, verde, violeta, rosa, petroleo.
  cor              String
  titulo           String
  /// Dica: a frase. Carrossel: a legenda.
  texto            String                 @default("")
  /// Artigo: os parágrafos.
  corpo            String[]
  /// Carrossel: os cartões depois do título.
  cartoes          String[]
  /// Enquete: as opções.
  opcoes           String[]
  /// Só na demonstração, para o feed não parecer vazio.
  curtidasIniciais Int                    @default(0)
  votosIniciais    Int[]
  criadoEm         DateTime               @default(now())
  reacoes          ReacaoAoConteudo[]
  comentarios      ComentarioDoConteudo[]

  @@index([profissionalId])
  @@index([criadoEm])
  @@map("conteudos")
}

/// Curtir, salvar ou votar (`opcao`) num conteúdo. `quem` é o id da pessoa ou do profissional.
model ReacaoAoConteudo {
  conteudoId String
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  quem       String
  /// curtir, salvar, votar.
  tipo       String
  opcao      Int?

  @@id([conteudoId, quem, tipo])
  @@map("reacoes_aos_conteudos")
}

model ComentarioDoConteudo {
  id             String        @id @default(uuid())
  conteudoId     String
  conteudo       Conteudo      @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  pessoaId       String?
  pessoa         Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  texto          String
  criadoEm       DateTime      @default(now())

  @@index([conteudoId, criadoEm])
  @@map("comentarios_dos_conteudos")
}

/// A pessoa segue o profissional em Conteúdos.
model Seguir {
  pessoaId       String
  pessoa         Pessoa       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  desde          DateTime     @default(now())

  @@id([pessoaId, profissionalId])
  @@map("seguir")
}
