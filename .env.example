# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Em dev e prod, os valores ficam nas variáveis de ambiente da Vercel
# (Preview = dev, Production = prod), cada uma com suas próprias chaves.

# Postgres. Localmente, o do Docker (pnpm db:up); em dev/prod, a Neon (branch
# "dev" em dev, "main" só em prod). As tabelas vêm das migrações (pnpm db:migrate).
DATABASE_URL=postgresql://desafoga:desafoga@localhost:5440/desafoga
# Banco separado para os testes de integração (criado pelo Docker). Nunca o mesmo do DATABASE_URL.
TEST_DATABASE_URL=postgresql://desafoga:desafoga@localhost:5440/desafoga_teste

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret do aplicativo da Meta; valida a assinatura de cada chamada
WHATSAPP_APP_SECRET=
# Opcional; versão da Graph API (padrão v23.0)
WHATSAPP_API_VERSION=

# WhatsApp pelo sandbox da Twilio (alternativa sem número próprio).
# Webhook a cadastrar na Twilio: https://<site>/api/twilio/webhook (POST)
TWILIO_ACCOUNT_SID=
# Assina cada chamada do webhook e autoriza o envio das respostas
TWILIO_AUTH_TOKEN=
# Opcional; remetente (padrão: número do sandbox, whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=
# Opcional; endereço exato cadastrado na Twilio, se a assinatura for recusada
TWILIO_WEBHOOK_URL=

# Chave da API do Gemini (aistudio.google.com), usada na leitura e na conversa
GEMINI_API_KEY=
# Opcional; teto diário de pedidos do site inteiro (padrão 4000)
LIMITE_GLOBAL_DIARIO=
# Opcional; modelo usado (padrão gemini-3.6-flash)
GEMINI_MODEL=

# Opcional; de onde vem a IA: gemini (padrão) ou claude-local (o Claude Code
# instalado na máquina, com o login dele; só no desenvolvimento, nunca na
# Vercel). No claude-local, o áudio continua no Gemini se houver GEMINI_API_KEY.
IA_PROVEDOR=
# Opcionais do claude-local: caminho do CLI (padrão claude), modelo (padrão
# sonnet) e pasta de configuração de outra conta (ex.: ~/.claude-trabalho)
CLAUDE_BIN=
CLAUDE_MODEL=
CLAUDE_CONFIG_DIR=

# Opcional; assina o link do painel enviado pelo WhatsApp. Vazio: a chave é
# derivada de TWILIO_AUTH_TOKEN ou WHATSAPP_APP_SECRET.
PAINEL_LINK_SECRET=

# Desafoga (app em /app e /painel)
# Número da Luana no WhatsApp e código "join" do sandbox da Twilio, mostrados
# na tela "Conectar WhatsApp" (ex.: +1 415 523 8886 e palavra-palavra).
NEXT_PUBLIC_WHATSAPP_NUMERO=
NEXT_PUBLIC_WHATSAPP_CODIGO=
# Só fora da Vercel: "1" quando o app roda atrás de um proxy seu que preenche
# x-forwarded-for. Sem isso, o endereço de rede não é usado nos limites de uso
# (o cliente poderia inventá-lo). Na Vercel não é preciso.
CONFIAR_NO_PROXY=

# Bancos conectados (Pluggy). Só no servidor: nunca em NEXT_PUBLIC_*.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# "1" mostra o banco de teste da Pluggy no widget.
PLUGGY_SANDBOX=
# https público do webhook (ex.: https://seu-app.vercel.app/api/pluggy/webhook) e um segredo longo aleatório.
PLUGGY_WEBHOOK_URL=
PLUGGY_WEBHOOK_SEGREDO=

# Agendador das mensagens automáticas (/api/agendador). O mesmo valor vai no
# segredo AGENDADOR_SEGREDO do GitHub, junto com AGENDADOR_URL. Vazio: desligado.
AGENDADOR_SEGREDO=
