# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Em dev e prod, os valores ficam nas variáveis de ambiente da Vercel
# (Preview = dev, Production = prod), cada uma com suas próprias chaves.

# Postgres (Neon). Use a branch "dev" do Neon localmente e em dev; "main" só em prod.
DATABASE_URL=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret do aplicativo da Meta; valida a assinatura de cada chamada
WHATSAPP_APP_SECRET=
# Opcional; versão da Graph API (padrão v23.0)
WHATSAPP_API_VERSION=

# Chave da API do Gemini (aistudio.google.com), usada na leitura e na conversa
GEMINI_API_KEY=
# Opcional; modelo usado (padrão gemini-3.8-flash)
GEMINI_MODEL=
